generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Doctor {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String
  license      String   @unique
  hospital     String
  specialty    String
  reputation   Int      @default(0)
  cmeCredits   Float    @default(0)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  followers    Follow[] @relation("Following")
  following    Follow[] @relation("Follower")
  notifications Notification[]
  isAdmin      Boolean  @default(false)
  consultationsAsDoctor     Consultation[] @relation("ConsultationDoctor")
  consultationsAsSpecialist Consultation[] @relation("ConsultationSpecialist")
  cases        Case[]
  responses    Response[]
  cmeLog       CMELog[]
  publicKey    String?
  behaviorLogs BehaviorLog[]
}

model Case {
  id             String   @id @default(cuid())
  title          String
  tag            String
  urgency        String
  age            Int
  sex            String
  history        String
  examination    String
  investigations String
  question       String
  views          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  doctorId       String
  doctor         Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  responses      Response[]
  cmeLog         CMELog[]
  isHoneypot   Boolean  @default(false)
}

model Response {
  id        String   @id @default(cuid())
  text      String
  helpful   Int      @default(0)
  createdAt DateTime @default(now())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CMELog {
  id        String   @id @default(cuid())
  action    String
  points    Float
  createdAt DateTime @default(now())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    Doctor   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   Doctor   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  @@unique([followerId, followingId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String
  read      Boolean  @default(false)
  caseId    String?
  createdAt DateTime @default(now())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model BlockchainLog {
  id           String   @id @default(cuid())
  blockNumber  Int      @unique @default(autoincrement())
  action       String
  entityType   String
  entityId     String
  doctorId     String
  dataHash     String
  previousHash String
  blockHash    String
  createdAt    DateTime @default(now())
}

model Consultation {
  id           String   @id @default(cuid())
  topic        String
  status       String   @default("pending")
  roomName     String?
  scheduledAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  doctorId     String
  doctor       Doctor   @relation("ConsultationDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  specialistId String
  specialist   Doctor   @relation("ConsultationSpecialist", fields: [specialistId], references: [id], onDelete: Cascade)
  notes        String?
}

model CaseKey {
  id           String   @id @default(cuid())
  caseId       String
  doctorId     String
  encryptedKey String   // case key encrypted with doctor's public key
  createdAt    DateTime @default(now())

  @@unique([caseId, doctorId])
}

model BehaviorLog {
  id        String   @default(cuid()) @id
  doctorId  String
  action    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

